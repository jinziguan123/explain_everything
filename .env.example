# ============================================================
# LLM 配置 (Phase 5+)
# ============================================================
# Phase 5 起协议跟供应商解耦，配 4 个 env var:

# 必填：协议（anthropic 或 openai）
LLM_PROTOCOL=anthropic

# 必填：API base url
# - Anthropic 官方:           https://api.anthropic.com
# - DeepSeek anthropic 端点:  https://api.deepseek.com/anthropic
# - OpenAI 官方:              https://api.openai.com/v1
# - DeepSeek openai 端点:     https://api.deepseek.com/v1
LLM_BASE_URL=https://api.anthropic.com
LLM_MAX_TOKENS=65536

# 必填：API key
LLM_API_KEY=

# 必填：模型
LLM_MODEL=claude-opus-4-7

# 可选：OpenAI 协议下 structured output 模式
# - json_schema (默认): OpenAI 官方 / Azure / 多数 vendor 支持
# - json_object       : DeepSeek 等不支持 json_schema strict 的 vendor 用
# LLM_STRUCTURED_OUTPUT_MODE=json_schema

# ============================================================
# Phase 17.2: Light-model 配置 (cheap LLM for classify / canonical)
# ============================================================
# 可选. 不配则 light 走主 LLM_* 配置 (跟 Phase 17.2 前 100% 等价).
# 推荐 haiku / gpt-4o-mini 等 cheap model 省 token.
# 失败 (网络 / SchemaValidationError) 由 with_light_fallback 自动 fallback 主 LLM.

# LLM_LIGHT_PROTOCOL=anthropic
# LLM_LIGHT_BASE_URL=https://api.anthropic.com
# LLM_LIGHT_API_KEY=
# LLM_LIGHT_MODEL=claude-haiku-4-5
# LLM_LIGHT_MAX_TOKENS=4096

# ============================================================
# Runtime 配置
# ============================================================
# 默认 cognitive budget（每个 session 最多多少 tick）
DEFAULT_BUDGET=20

# Session JSON 落地目录
SESSIONS_DIR=./sessions

# ============================================================
# Phase 17.1: Lexicon PostgreSQL (远程 server 部署)
# ============================================================
# 部署在 172.30.26.12 的 pgvector/pgvector:pg16 container.
# 参考 deploy/postgres/README.md 部署步骤.
#
# DSN 格式: postgresql://<用户名>:<密码>@<主机>:<端口>/<数据库>
# 默认密码 changeme — **生产必改为强密码** (建议 24+ 字符随机串).
EXPLAIN_DB_URL=postgresql://explain:changeme@172.30.26.12:5432/explain

# 可选 pool 调优 (默认值 cover 单用户 chat REPL, 多并发调高 max)
EXPLAIN_DB_POOL_MIN=2
EXPLAIN_DB_POOL_MAX=10
EXPLAIN_DB_CONNECT_TIMEOUT_S=5

# Test database — 跟生产 explain 库物理隔离 (不同 database, 同 PG instance).
# 用户在 172.30.26.12 跑 1 次:
#   ssh user@172.30.26.12 'docker exec explain-postgres psql -U explain -c "CREATE DATABASE explain_test"'
#   ssh user@172.30.26.12 'docker exec -i explain-postgres psql -U explain -d explain_test' < deploy/postgres/init/01-init.sql
# 没设此 var 时 lexicon_pg test 自动 SKIP (既有 test 不挂).
EXPLAIN_TEST_DB_URL=postgresql://explain:changeme@172.30.26.12:5432/explain_test
