/* Phase 19 Wave 3-4: ExplainChatApp 基础 CSS.
 * 设计参考 docs/plans/2026-05-27-phase-19-tui-design.md §4.3.
 * Wave 4: RichLog → VerticalScroll 激进迁移 + Collapsible thinking 样式.
 * Wave 6 加 splash-* 类.
 */

Screen {
    background: $surface;
}

VerticalScroll#output {
    border: solid $primary;
    padding: 1;
}

Input#prompt {
    dock: bottom;
    border: tall $primary;
}

/* Wave 4: thinking Collapsible — dim 边框 + 紧凑 padding. */
Collapsible {
    background: $surface;
    border: tall $surface-lighten-1;
    padding: 0 1;
    margin: 0 0 1 0;
}

/* Wave 4 review C-1: thinking 内容用 markup=False 避免 LLM reasoning 含
 * [INST]/[FOO] 等被 Content markup parser 吃掉. dim 样式走 CSS class. */
Static.thinking-content {
    color: $text-muted;
}

/* Wave 5 Task 24: status spinner (LoadingIndicator + label) 样式.
 * label dim text + 紧贴 indicator (margin 0). LoadingIndicator
 * accent 色让转圈 visible. */
LoadingIndicator {
    color: $accent;
    height: 1;
}

Static.status-label {
    color: $text-muted;
    padding: 0 1;
    height: 1;
}

/* Wave 6 Task 29/30: SplashScreen 启屏样式.
 * Layout: Vertical#splash-container 居中, logo bold cyan, version dim,
 * step-i 三态: pending (dim) / active (yellow) / done (green) / failed (red).
 * markup=False — pyfiglet ASCII / 中文 label 文字直接渲染, 不靠 markup. */
Vertical#splash-container {
    align: center middle;
    height: 100%;
    width: 100%;
    padding: 2;
}

Static.splash-logo {
    color: $accent;
    text-style: bold;
    content-align: center middle;
    height: auto;
    margin: 0 0 1 0;
}

Static.splash-version {
    color: $text-muted;
    content-align: center middle;
    height: 1;
    margin: 0 0 2 0;
}

Static.splash-step-pending {
    color: $text-muted;
    height: 1;
}

Static.splash-step-active {
    color: $warning;
    height: 1;
}

Static.splash-step-done {
    color: $success;
    height: 1;
}

Static.splash-step-failed {
    color: $error;
    height: 1;
}
